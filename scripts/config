#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# CUSTOM SETTERS
#=================================================

# Each setter is called by the config panel when the matching question changes.
# The new value is provided by the core in a shell variable named after the
# short question key, so a custom setter is responsible for persisting it (the
# helper only calls the setter and does no automatic saving). We therefore
# store the new value with ynh_app_setting_set, then re-render the environment
# file / nginx configuration and restart the services so it takes effect.

set__open_notebook_password() {
    ynh_app_setting_set --key="open_notebook_password" --value="$open_notebook_password"
    open_notebook_apply_config
}

set__max_upload_size() {
    ynh_app_setting_set --key="max_upload_size" --value="$max_upload_size"
    open_notebook_apply_config
}

set__worker_max_tasks() {
    ynh_app_setting_set --key="worker_max_tasks" --value="$worker_max_tasks"
    open_notebook_apply_config
}

set__chunk_size() {
    ynh_app_setting_set --key="chunk_size" --value="$chunk_size"
    open_notebook_apply_config
}

set__chunk_overlap() {
    ynh_app_setting_set --key="chunk_overlap" --value="$chunk_overlap"
    open_notebook_apply_config
}

set__enable_docling() {
    ynh_app_setting_set --key="enable_docling" --value="$enable_docling"
    if [ "$enable_docling" == "true" ]; then
        ynh_print_info "Installing the optional Docling dependency (this can take a while)..."
        open_notebook_install_optional_runtime "docling"
    fi
    open_notebook_apply_config
}

set__enable_crawl4ai() {
    ynh_app_setting_set --key="enable_crawl4ai" --value="$enable_crawl4ai"
    if [ "$enable_crawl4ai" == "true" ]; then
        ynh_print_info "Installing the optional Crawl4AI dependency and browser (this can take a while)..."
        open_notebook_install_optional_runtime "crawl4ai"
    fi
    open_notebook_apply_config
}

#=================================================
# RUN
#=================================================

ynh_app_config_run "$1"
