#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# UPDATE THE URL
#=================================================

ynh_script_progression "Updating open-notebook URL..."

open_notebook_stop_services

ynh_config_change_url_nginx

# Keep the recorded public URL in sync.
ynh_app_setting_set --key=public_url --value="https://${domain}${path}"

# Re-render every config that depends on the domain/path: the .env (API_URL and
# the CORS origin), the systemd units, nginx, logrotate and the fail2ban jail
# (whose logpath embeds $domain, so a domain change must move it too).
open_notebook_configure

# The base path is baked into the frontend build, so rebuild it only when the
# path itself changed (a domain-only change needs no rebuild).
if [ "${old_path:-}" != "${path:-}" ]; then
    ynh_script_progression "Rebuilding the frontend for the new base path..."
    open_notebook_build_frontend
fi

open_notebook_start_services

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "URL update of $app completed" --last
