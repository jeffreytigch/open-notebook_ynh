#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE DATA
#=================================================

ynh_script_progression "Restoring open-notebook data..."

# SurrealDB snapshot taken by scripts/backup (stored in $YNH_APP_BACKUP_DIR,
# which the backup extracted automatically). It is absent from a safety backup
# taken before an upgrade (and when "do_not_backup_data" is set); in that case
# the existing database is kept as-is, exactly like the user data below.
if [ -d "$YNH_APP_BACKUP_DIR/surreal_data" ]; then
    rm -rf "$data_dir/surreal_data"
    cp -a "$YNH_APP_BACKUP_DIR/surreal_data" "$data_dir/surreal_data"
else
    ynh_print_info "No SurrealDB snapshot in this backup: keeping the existing database."
fi

# Uploads, podcast audio and the LangGraph sqlite checkpoints.
# ynh_restore itself skips $data_dir paths that are missing from the archive.
ynh_restore "$data_dir/data"

# ynh_restore applies YunoHost's "default permissions" to the restored path:
# any target that is neither $install_dir nor $data_dir itself is forced to
# mode 400. For a restored *directory* that makes it untraversable, and the app
# then cannot reach its own data (the API crashes on ./data/sqlite-db). Restore
# sane permissions: owner rwX everywhere (dirs get traversal), group nothing.
chmod -R u+rwX,go-rwx "$data_dir/data"
chmod 750 "$data_dir/data"

chown -R "$app:$app" "$data_dir"

#=================================================
# REBUILD THE APPLICATION
#=================================================

# The application code is not backed up: it is fully reproducible from the
# pinned sources (and the venv / frontend bundle are regenerated by the build).
ynh_script_progression "Retrieving open-notebook source..."
open_notebook_setup_source full

ynh_script_progression "Rebuilding the Python backend (uv)..."
open_notebook_build_backend

ynh_script_progression "Rebuilding the frontend (this may take several minutes)..."
open_notebook_build_frontend

#=================================================
# RESTORE CONFIGURATIONS
#=================================================

ynh_script_progression "Restoring configurations..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/systemd/system/$app.service"
ynh_restore "/etc/systemd/system/$app-api.service"
ynh_restore "/etc/systemd/system/$app-worker.service"
ynh_restore "/etc/systemd/system/$app-surreal.service"
ynh_restore "/etc/logrotate.d/$app"
ynh_restore "/etc/fail2ban/jail.d/$app.conf"
ynh_restore "/etc/fail2ban/filter.d/$app.conf"

# Everything is re-rendered from the settings anyway.
open_notebook_configure
open_notebook_register_services
open_notebook_set_logo

#=================================================
# START SERVICES
#=================================================

ynh_script_progression "Starting services..."
open_notebook_start_services

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restore of $app completed" --last
