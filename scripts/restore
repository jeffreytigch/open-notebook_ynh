#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE DATA
#=================================================

ynh_script_progression "Restoring open-notebook data..."
ynh_restore "$data_dir"
chown -R "$app:$app" "$data_dir"

#=================================================
# REBUILD THE APPLICATION
#=================================================

# The application code is not backed up: it is fully reproducible from the
# pinned sources (and the venv / frontend bundle are regenerated by the build).
ynh_script_progression "Retrieving open-notebook source..."
open_notebook_setup_source full

ynh_script_progression "Rebuilding the Python backend (uv)..."
open_notebook_build_backend

ynh_script_progression "Rebuilding the frontend (this may take several minutes)..."
open_notebook_build_frontend

#=================================================
# RECONFIGURE
#=================================================

ynh_script_progression "Reconfiguring open-notebook..."
open_notebook_configure
open_notebook_register_services

#=================================================
# START SERVICES
#=================================================

ynh_script_progression "Starting services..."
open_notebook_start_services

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restore of $app completed" --last
