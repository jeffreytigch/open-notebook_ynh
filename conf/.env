# open-notebook environment file.
# Shared by the api, worker and frontend systemd services.
# Managed by YunoHost -- do not edit by hand. Use the config panel instead.

### Core
OPEN_NOTEBOOK_ENCRYPTION_KEY=__ENCRYPTION_KEY__
OPEN_NOTEBOOK_PASSWORD=__OPEN_NOTEBOOK_PASSWORD__
OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=__MAX_UPLOAD_SIZE__
OPEN_NOTEBOOK_WORKER_MAX_TASKS=__WORKER_MAX_TASKS__
OPEN_NOTEBOOK_CHUNK_SIZE=__CHUNK_SIZE__
OPEN_NOTEBOOK_CHUNK_OVERLAP=__CHUNK_OVERLAP__
OPEN_NOTEBOOK_ENABLE_DOCLING=__ENABLE_DOCLING__
OPEN_NOTEBOOK_ENABLE_CRAWL4AI=__ENABLE_CRAWL4AI__

### Database
SURREAL_URL=ws://127.0.0.1:__PORT_SURREAL__/rpc
SURREAL_USER=__SURREAL_USER__
SURREAL_PASSWORD=__SURREAL_PASSWORD__
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

### API
API_HOST=127.0.0.1
API_PORT=__PORT_API__
API_RELOAD=false
CORS_ORIGINS=https://__DOMAIN__

### Frontend
PORT=__PORT__
HOSTNAME=127.0.0.1
API_URL=__PUBLIC_URL__
INTERNAL_API_URL=http://127.0.0.1:__PORT_API__

### Paths / caches
# Everything below lives on the data volume so it survives upgrades/restores.
TIKTOKEN_CACHE_DIR=__DATA_DIR__/data/tiktoken-cache
# Where the optional Crawl4AI runtime looks for (and downloads) Chromium.
PLAYWRIGHT_BROWSERS_PATH=__DATA_DIR__/data/playwright
# Model cache for the optional Docling runtime (and any other HuggingFace download).
HF_HOME=__DATA_DIR__/data/huggingface
